{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
      {
        "source": "/__/auth/:path*",
        "destination": "https://nvelope-3e3b.firebaseapp.com/__/auth/:path*"
      },
      {
        "source": "/__/firebase/:path*",
        "destination": "https://nvelope-3e3b.firebaseapp.com/__/firebase/:path*"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }