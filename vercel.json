{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
      {
        "source": "/__/auth/:path*",
        "destination": "https://nvelope-3e93b.firebaseapp.com/__/auth/:path*"
      },
      {
        "source": "/__/firebase/:path*",
        "destination": "https://nvelope-3e93b.firebaseapp.com/__/firebase/:path*"
      },
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
    "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
  }