rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/budgets/{budgetId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId
        || get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId == request.auth.uid
      );
    }
    match /budgets/{budgetId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.get('memberIds', []);
    }
    match /budgets/{budgetId}/data/{dataId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId
            || request.auth.uid in get(/databases/$(database)/documents/budgets/$(budgetId)).data.get('memberIds', []));
    }
    // Append-only audit log written by both clients; no update/delete once created.
    match /budgets/{budgetId}/transactions/{transactionId} {
      allow read, create: if request.auth != null
        && (request.auth.uid == get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId
            || request.auth.uid in get(/databases/$(database)/documents/budgets/$(budgetId)).data.get('memberIds', []));
    }
    match /userBackups/{userId}/backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Invite tokens (mobile token API): server (Admin SDK) creates/updates via backend, bypassing rules.
    // Public read so the /i/:token landing page can show status before the user signs in.
    match /invites/{token} {
      allow read: if true;
    }
  }
}
