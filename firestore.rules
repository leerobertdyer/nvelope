rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/budgets/{budgetId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /budgets/{budgetId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.uid in resource.data.get('memberIds', []));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.get('memberIds', []);
      // Invited user (not yet a member) may update ONLY to add themselves to memberIds.
      allow update: if request.auth != null
        && request.auth.uid != resource.data.ownerId
        && !(request.auth.uid in resource.data.get('memberIds', []))
        // Only the memberIds field may change (e.g. arrayUnion(uid)); no name/ownerId/etc.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        // Invite doc must exist for this budget + signed-in user's email (Firebase token email, lowercase).
        && exists(/databases/$(database)/documents/budgets/$(budgetId)/invites/$(request.auth.token.email));
    }
    // One invite doc per (budget, email). Doc id = normalized email so rule can reference request.auth.token.email.
    match /budgets/{budgetId}/invites/{inviteEmail} {
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId == request.auth.uid;
      // Invited user can read/delete only their own invite (inviteEmail == their token email). Owner can read/delete any invite.
      allow read, delete: if request.auth != null
        && (request.auth.token.email == inviteEmail
            || get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId == request.auth.uid);
    }
    match /budgets/{budgetId}/data/{dataId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId
            || request.auth.uid in get(/databases/$(database)/documents/budgets/$(budgetId)).data.get('memberIds', []));
    }
    match /userBackups/{userId}/backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Invites by email: owner can create; invited user can read/delete (to accept)
    match /budgetInvites/{inviteId} {
      allow read, delete: if request.auth != null && resource.data.email == request.auth.token.email;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/budgets/$(request.resource.data.budgetId)).data.ownerId == request.auth.uid;
    }
  }
}
