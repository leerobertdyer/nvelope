rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/budgets/{budgetId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId
        || get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId == request.auth.uid
      );
    }
    match /budgets/{budgetId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == resource.data.ownerId
            || request.auth.uid in resource.data.get('memberIds', []));
      // Invited user (has matching budgetInvites doc) may read budget to get name/memberIds before accepting
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/budgetInvites/$(budgetId + '_' + request.auth.token.email));
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId
        && request.auth.uid in request.resource.data.get('memberIds', []);
      // Invited user (not yet a member) may update ONLY to add themselves to memberIds and memberEmails.
      allow update: if request.auth != null
        && request.auth.uid != resource.data.ownerId
        && !(request.auth.uid in resource.data.get('memberIds', []))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberEmails'])
        && exists(/databases/$(database)/documents/budgetInvites/$(budgetId + '_' + request.auth.token.email));
    }
    match /budgets/{budgetId}/data/{dataId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId
            || request.auth.uid in get(/databases/$(database)/documents/budgets/$(budgetId)).data.get('memberIds', []));
    }
    // Append-only audit log written by both clients; no update/delete once created.
    match /budgets/{budgetId}/transactions/{transactionId} {
      allow read, create: if request.auth != null
        && (request.auth.uid == get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerId
            || request.auth.uid in get(/databases/$(database)/documents/budgets/$(budgetId)).data.get('memberIds', []));
    }
    match /userBackups/{userId}/backups/{backupId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Invite tokens (mobile token API): server (Admin SDK) creates/updates via backend, bypassing rules.
    // Public read so the /i/:token landing page can show status before the user signs in.
    match /invites/{token} {
      allow read: if true;
    }
    // Invites by email: owner can create (doc ID must be budgetId_email); invited user can read/delete (to accept)
    match /budgetInvites/{inviteId} {
      allow read, delete: if request.auth != null && resource.data.email == request.auth.token.email;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/budgets/$(request.resource.data.budgetId)).data.ownerId == request.auth.uid
        && request.resource.id == request.resource.data.budgetId + '_' + request.resource.data.email;
    }
  }
}
